# Copy this file to .env and DO NOT commit .env to git.
# Inside Docker, services talk to each other by container name (db, redis) — not localhost.

DATABASE_URL=postgresql://supplyrisk:supplyrisk@db:5432/supplyrisk
REDIS_URL=redis://redis:6379/0

# Used later for GitHub/npm/PyPI crawlers (Person B will fill this in)
GITHUB_TOKEN=

# Used for auth (Person C will fill this in)
JWT_SECRET_KEY=change-this-to-a-random-string
